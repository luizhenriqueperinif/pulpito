{
  "name": "auxilio-reuniao",
  "version": "1.0.0",
  "private": true,
  "description": "Púlpito: prepara a reunião no notebook e conduz pelo celular, projetando na TV da igreja.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "instalador": "electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "author": "Luiz Henrique",
  "build": {
    "appId": "br.igreja.auxilioreuniao",
    "productName": "Púlpito",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "executableName": "Pulpito"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Púlpito",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Instalar-Pulpito-${version}.${ext}"
    }
  }
}
